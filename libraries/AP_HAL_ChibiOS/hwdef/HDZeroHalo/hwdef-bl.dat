# HDZero Halo bootloader hwdef
#
# ************************************************************************
# WP3-J: HSI64 SYSCLK (OSCILLATOR_HZ 0), USB HSI48. Matches proven DiagBL
# clock path. Normal app jump retained. NOT VERIFIED on hardware —
# HARDWARE_FLASH_ALLOWED = NO until independent review.
# ************************************************************************

# MCU class and specific type
MCU STM32H7xx STM32H743xx

APJ_BOARD_ID AP_HW_HDZERO_HALO

# HSI64 PLL source, HSE disabled (ChibiOS STM32_HSECLK 0U → 400 MHz SYSCLK).
# Proven on Halo diagnostic bootloader (WP3-I). Must match main hwdef.dat.
OSCILLATOR_HZ 0

FLASH_SIZE_KB 2048

# bootloader at start of flash
FLASH_RESERVE_START_KB 0

# Must match FLASH_RESERVE_START_KB in hwdef.dat (provisional 128 KB)
FLASH_BOOTLOADER_LOAD_KB 128

# USB bootloading only (safe minimal set)
SERIAL_ORDER OTG1

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
# USB FS clock = HSI48 (independent of HSE). Same as application.
define STM32_USBSEL STM32_USBSEL_HSI48_CK

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Hold CS high in bootloader
PB4 GYRO1_CS CS
PB3 GYRO2_CS CS
PB12 FLASH_CS CS

# Status LED
PE2 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

# Active-HIGH buzzer: inactive after bootloader GPIO initialisation.
PD12 BUZZER OUTPUT LOW

# Inactive software level after GPIO initialisation; reset/ROM DFU unverified.
PE3 VTX_PWR OUTPUT LOW

# Pinned ChibiOS startup has no software DFU entry hook; use physical BOOT.
